    "postinstall": "node -e \"for(const d of require('fs').readdirSync('node_modules/node-pty/prebuilds',{withFileTypes:true}))try{require('fs').chmodSync('node_modules/node-pty/prebuilds/'+d.name+'/spawn-helper',0o755)}catch{}\""
